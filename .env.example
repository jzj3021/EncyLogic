# Copy to .env (or source it) and adjust for your machine.
# All values have defaults in encylogic/config.py; override only what you need.

# Workspace root holding benchmarks/, data/, models/, results/.
export ENCYLOGIC_ROOT=./workspace

# External tool binaries (must be installed separately).
export ABC_BIN=abc
export YOSYS_BIN=yosys
export OPENROAD_BIN=openroad

# ASAP7 (or other) merged liberty used by ABC `map` and ASIC delay/area eval.
export ENCYLOGIC_LIB=./workspace/lib/asap7_merged_RVT_TT_NOSRAM.lib

# OpenROAD physical-evaluation service endpoint (encylogic/serving/openroad_server.py).
export ENCYLOGIC_API_URL=http://127.0.0.1:8088/evaluate

# Optional explicit overrides.
# export ENCYLOGIC_BENCHMARKS=./workspace/benchmarks
# export ENCYLOGIC_MODELS=./workspace/models
